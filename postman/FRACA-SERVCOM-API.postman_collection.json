{
  "info": {
    "_postman_id": "fraca-servcom-inventory-api-2026",
    "name": "FRACA SERVCOM Inventory Management System - API",
    "description": "Complete API test collection for the FRACA SERVCOM Inventory Management System\n\nIncludes:\n- Authentication (login/logout)\n- Product CRUD operations\n- Sales transactions\n- Purchase orders\n- Stock management\n- Reporting\n\nEnvironment Variables Required:\n- {{base_url}}: API base URL (e.g., http://localhost:8000/api/v1)\n- {{admin_token}}: Bearer token for admin user\n- {{staff_token}}: Bearer token for staff user\n- {{customer_id}}: Customer ID for testing\n- {{supplier_id}}: Supplier ID for testing\n- {{product_id}}: Product ID for testing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('admin_token', jsonData.access_token);",
                  "    pm.test('Admin login successful', function() {",
                  "        pm.expect(jsonData.access_token).to.be.a('string');",
                  "        pm.expect(jsonData.token_type).to.equal('Bearer');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@test.local\",\n    \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            }
          },
          "response": []
        },
